# Server-only. The browser calls /api/backend/*, which next.config.mjs rewrites
# to this URL — so it's read at build/start, and changing it needs a restart.
API_BASE_URL=
NEXT_PUBLIC_USE_MOCKS=true
# Server-only Google Maps key (Static Maps API) for the order delivery-map
# preview, served through /api/maps/static so the key never reaches the browser.
GOOGLE_PLACES_API_KEY=
